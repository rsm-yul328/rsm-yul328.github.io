X <- as.matrix(data)
# Function to calculate Euclidean distance
euclidean <- function(a, b) {
sqrt(sum((a - b)^2))
}
# Custom K-Means function
kmeans_custom <- function(X, k = 3, max_iter = 100) {
set.seed(123)
n <- nrow(X)
d <- ncol(X)
# Randomly initialize centroids
centroids <- X[sample(1:n, k), ]
clusters <- rep(0, n)
for (iter in 1:max_iter) {
old_clusters <- clusters
# Step 1: Assign clusters
for (i in 1:n) {
distances <- apply(centroids, 1, function(c) euclidean(X[i, ], c))
clusters[i] <- which.min(distances)
}
# Step 2: Update centroids
for (j in 1:k) {
if (sum(clusters == j) > 0) {
centroids[j, ] <- colMeans(X[clusters == j, , drop = FALSE])
}
}
# Plot step
df_plot <- data.frame(X, cluster = as.factor(clusters))
ggplot(df_plot, aes(x = bill_length_mm, y = flipper_length_mm, color = cluster)) +
geom_point() +
geom_point(data = data.frame(centroids), aes(x = centroids[,1], y = centroids[,2]), color = "black", size = 3, shape = 8) +
ggtitle(paste("Iteration", iter)) +
theme_minimal() +
print()
# Check for convergence
if (all(old_clusters == clusters)) {
break
}
}
return(list(centroids = centroids, clusters = clusters))
}
# Run custom k-means
result_custom <- kmeans_custom(X, k = 3)
